# Each user now sets their own profile, SMTP login, Gemini key/model and daily limit
# from the ⚙ Settings button after logging in. Nothing else is required here.

# Optional: key used to encrypt saved SMTP passwords and Gemini keys.
# If unset, one is generated in data/secret.key (keep that file safe and don't lose it).
# APP_SECRET_KEY=

# Database: Postgres (e.g. Supabase). Leave unset to use the local SQLite file data/jobs.db.
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=
# (or a single DATABASE_URL=postgresql://user:password@host:5432/postgres)
